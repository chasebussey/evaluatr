<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>evaluatr</AssemblyName>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>evaluatr</ToolCommandName>
        <PackageId>Evaluatr.Cli</PackageId>
        <Version>0.0.1-alpha</Version>
        <Description>CLI tool for running eval suites.</Description>

    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Evaluatr.Core/Evaluatr.Core.csproj" />
        <ProjectReference Include="../Evaluatr.Copilot/Evaluatr.Copilot.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Evaluatr.Cli.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
    </ItemGroup>

</Project>
